            }
          }
        },
        "parameters": [
          {
            "name": "topicId",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "paperId",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "protocolId",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "ExtractionRoutes"
        ]
      },
      "post": {
        "operationId": "ExtractionRoutes_UpsertExtraction",
