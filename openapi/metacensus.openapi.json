            "post": {
                "operationId": "ExtractionRoutes_UpsertExtraction",
                "responses": {
                    "200": {
                        "description": "A successful response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/v1DataExtraction"
                                }
                            }
                        }
                    }
