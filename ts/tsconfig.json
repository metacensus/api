{
  "compilerOptions": {
    // NodeNext, like packages/contract: this is a publishable package, so its
    // types have to resolve under plain Node and not only inside a bundler.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],

    // Strict is the point. `useOptionals=messages` marks message-typed fields
    // `?: T | undefined`, and that only means anything under strictNullChecks —
    // without it the golden cross-check would accept a `null` where the
    // contract says a key is simply absent, which is exactly the
    // EmitUnpopulated behaviour this contract rejected.
    "strict": true,

    // Nothing is compiled: the package ships the `.ts` sources and consumers
    // import them as types. `tsc --noEmit` is a check, not a build.
    "noEmit": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["index.ts", "src", "test"]
}
