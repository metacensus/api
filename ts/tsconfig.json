{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    // DOM is here for WebCrypto, which src/signing.ts reaches through the
    // `crypto` global: `SubtleCrypto`, `CryptoKey`, `TextEncoder`, `btoa`.
    // TypeScript ships those types in lib.dom and nowhere narrower, and the
    // alternative — @types/node — would type the package for one runtime when
    // the browser is the consumer that matters. It is a type-level lib, not a
    // runtime dependency: nothing it names is imported.
    //
    // ESNext.TypedArrays, not the whole of ESNext, for one thing: Uint8Array's
    // base64 codec (toBase64/fromBase64) that src/signing.ts uses. Node 22+ and
    // current browsers have it; older runtimes are why it's named, not assumed.
    "lib": ["ES2022", "DOM", "ESNext.TypedArrays"],

    // strictNullChecks is what makes `?: T | undefined` mean anything.
    "strict": true,

    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["index.ts", "public.ts", "signing.ts", "src"]
}
