{
  "name": "@metacensus/api",
  "version": "0.0.0",
  "description": "TypeScript interfaces generated from the MetaCensus API contract (/metacensus/api/v1). Types only, no runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metacensus/api.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/metacensus/api#readme",
  "bugs": {
    "url": "https://github.com/metacensus/api/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && node scripts/check-no-runtime.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "ts-proto": "2.7.7",
    "typescript": "5.5.4"
  }
}
