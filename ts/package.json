{
  "name": "@metacensus/api",
  "version": "0.0.0",
  "description": "TypeScript for the MetaCensus API contract (/metacensus/api/v1 and /metacensus/public): generated types, a route manifest, and a typed transport-agnostic client per surface. No runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metacensus/api.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/metacensus/api#readme",
  "bugs": {
    "url": "https://github.com/metacensus/api/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && node scripts/check-no-runtime.mjs && node scripts/check-entry-points.mjs",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "ts-proto": "2.7.7",
    "typescript": "7.0.2"
  }
}
